<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.paint.RadialGradient?>
<?import javafx.scene.paint.Stop?>

<BorderPane prefHeight="760" prefWidth="1000" stylesheets="@styles/app.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.KatalogController">
    <top>
        <VBox spacing="8" styleClass="header">
            <Label styleClass="title" text="Katalog Produk">
            <textFill>
               <RadialGradient centerX="0.5" centerY="0.5" radius="0.5">
                  <stops>
                     <Stop>
                        <color>
                           <Color />
                        </color>
                     </Stop>
                     <Stop offset="1.0">
                        <color>
                           <Color red="1.0" green="1.0" blue="1.0" />
                        </color>
                     </Stop>
                  </stops>
               </RadialGradient>
            </textFill></Label>
            <Label styleClass="muted" text="Isi form, simpan, lalu lihat katalog." wrapText="true" />
            <Label text="Nama produk" textFill="WHITE" />
            <TextField fx:id="namaField" promptText="Contoh: Roti Cokelat" />
            <Label text="Harga (Rp)" textFill="WHITE" />
            <TextField fx:id="hargaField" promptText="Contoh: 10000" />
            <Label text="Foto contoh" textFill="WHITE" />
            <ComboBox fx:id="fotoBox" maxWidth="Infinity" />
            <HBox spacing="10">
                <Button fx:id="simpanButton" onAction="#saveProduct" styleClass="button-primary" text="Simpan" />
                <Button fx:id="batalButton" managed="false" onAction="#cancelEdit" styleClass="button-secondary" text="Batal" visible="false" />
            </HBox>
            <Label fx:id="pesanLabel" wrapText="true" />
            <Label fx:id="jumlahLabel" text="Jumlah produk: 0" textFill="WHITE" />
        </VBox>
    </top>
    <center>
        <ScrollPane fitToHeight="false" fitToWidth="true">
            <content>
                <TilePane fx:id="katalogPane" alignment="TOP_LEFT" hgap="16" styleClass="katalog" tileAlignment="TOP_LEFT" vgap="16" />
            </content>
        </ScrollPane>
    </center>
</BorderPane>
